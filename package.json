{
  "name": "kickstarter",
  "type": "module",
  "version": "1.0.0",
  "description": "Kickstarter",
  "scripts": {
    "init": "mate-scripts init",
    "start": "mate-scripts start",
    "style-format": "npx stylelint 'src/**/*.scss' --fix --allow-empty-input",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{html,css,scss}'",
    "lint": "npm run style-format && npm run format && mate-scripts lint",
    "test:only": "mate-scripts test",
    "build": "mate-scripts build",
    "deploy": "mate-scripts deploy",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "lint1": "eslint .js,.jsx",
    "lint1:fix": "eslint .js,.jsx --fix"
  },
  "keywords": [],
  "author": "Mate Academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@linthtml/linthtml": "^0.9.6",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/jest-mochawesome-reporter": "^1.0.0",
    "@mate-academy/linthtml-config": "latest",
    "@mate-academy/scripts": "^2.1.1",
    "@mate-academy/stylelint-config": "latest",
    "@parcel/transformer-sass": "^2.15.4",
    "cypress": "^13.13.0",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "parcel": "^2.12.0",
    "prettier": "^3.3.2",
    "sass-lint": "^1.13.1",
    "stylelint": "^16.23.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.4.1",
    "typescript-eslint": "^8.42.0"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "mateAcademy": {
    "projectType": "layout",
    "linters": {
      "javascript": false,
      "bem": false
    },
    "tests": {
      "jest": false,
      "backstop": false,
      "cypress": true
    }
  },
  "dependencies": {
    "swiper": "^6.8.4"
  }
}
